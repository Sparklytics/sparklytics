# Sparklytics self-hosted example configuration
SPARKLYTICS_PORT=3000
SPARKLYTICS_DATA_DIR=./data
SPARKLYTICS_AUTH=local
SPARKLYTICS_HTTPS=false
SPARKLYTICS_SESSION_DAYS=7
SPARKLYTICS_RETENTION_DAYS=365
SPARKLYTICS_DUCKDB_MEMORY=1GB
SPARKLYTICS_PUBLIC_URL=http://localhost:3000
SPARKLYTICS_GEOIP_PATH=./dbip-city-lite.mmdb

# Trust proxy CIDRs before accepting X-Forwarded-For / X-Real-IP.
# Example for a local reverse proxy:
# SPARKLYTICS_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Optional dashboard/API CORS list (comma separated)
# SPARKLYTICS_CORS_ORIGINS=http://localhost:3001

# Cloud runtime variables, billing, cloud auth providers, warehouse backends,
# and private ops config belong in the private sparklytics-cloud repository,
# not this public self-host example.
